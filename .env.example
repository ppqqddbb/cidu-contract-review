APP_NAME=合同智审
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://contract_review:change_me@127.0.0.1:5432/contract_review
FILE_STORAGE_ROOT=.data/files
DIFY_BASE_URL=http://127.0.0.1
DIFY_API_KEY=
DIFY_CLASSIFICATION_WORKFLOW_ID=
DIFY_REVIEW_WORKFLOW_ID=
DIFY_CONNECT_TIMEOUT_SECONDS=5
DIFY_READ_TIMEOUT_SECONDS=60
# Kingdee case-file storage Custom API. Keep credentials on the API host.
KINGDEE_CASE_STORAGE_URL=
# Optional value for the Authorization request header, for example Bearer <access-token>.
KINGDEE_CASE_STORAGE_AUTHORIZATION=
# Preferred for Kingdee: OAuth token endpoint and an API-client credential.
KINGDEE_CASE_STORAGE_TOKEN_URL=
KINGDEE_CASE_STORAGE_CLIENT_ID=
KINGDEE_CASE_STORAGE_CLIENT_SECRET=
KINGDEE_CASE_STORAGE_USERNAME=
KINGDEE_CASE_STORAGE_ACCOUNT_ID=
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=60
