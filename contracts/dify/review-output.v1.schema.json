{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-output.v1",
  "title": "Contract Review Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_version",
    "knowledge_release_id",
    "run_id",
    "risks"
  ],
  "properties": {
    "schema_version": { "const": "review-output.v1" },
    "workflow_version": { "type": "string", "minLength": 1 },
    "knowledge_release_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "minLength": 1 },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clause_id",
          "rule_id",
          "risk_level",
          "title",
          "reason",
          "source_quote",
          "suggestion",
          "confidence",
          "evidence"
        ],
        "properties": {
          "clause_id": { "type": "string", "format": "uuid" },
          "rule_id": { "type": "string", "minLength": 1 },
          "risk_level": {
            "enum": ["critical", "high", "medium", "low", "info", "needs_human"]
          },
          "title": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "source_quote": { "type": "string" },
          "suggestion": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "document_id", "segment_id"],
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "segment_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
